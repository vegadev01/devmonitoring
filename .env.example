# --- Domain (Caddy issues the TLS certificate automatically) ---
DOMAIN=devmonitor.veganext.com
# Public HTTP port. Keep 80 with a domain. For IP-only mode use e.g.
#   DOMAIN=:8080  HTTP_PORT=8080  PUBLIC_*_URL=http://<ip>:8080[/api]
HTTP_PORT=80

# --- Postgres ---
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=change-me
POSTGRES_DB=monitoring
DATABASE_URL=postgresql://monitoring:change-me@db:5432/monitoring

# --- Admin login (dashboard) ---
# Only used to create the first accounts (when there are none yet). After that, admins manage
# accounts on the Users page and changes here are ignored — except that if no admin account
# exists any more, ADMIN_USER is restored from these values on the next API restart.
ADMIN_USER=admin_veganext
# Generate with: node api/scripts/hash-password.js "your-password"
# IMPORTANT: docker-compose interpolates $ in .env files, so every literal "$"
# in the bcrypt hash must be escaped as "$$" here (e.g. $2a$10$... -> $$2a$$10$$...)
# (the script prints the escaped form for you)
ADMIN_PASSWORD_HASH=

# --- First staff login (dashboard; optional, created on first start only) ---
STAFF_USER=staff_veganext
STAFF_PASSWORD_HASH=

# --- Auth/session secret (use a long random string: openssl rand -hex 32) ---
SESSION_SECRET=change-me-too

# --- Email alerts ---
# Alerts go to the admins listed under Notifications in the app (seeded with the Veganext admin list).
# Nothing is emailed until a provider below is configured.
MAIL_FROM="DevMonitor <support@veganext.com>"

# Microsoft 365 (recommended): an Azure app registration with the Microsoft Graph *application*
# permissions Mail.Send and MailboxSettings.Read (admin consent granted). See README.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Any other provider: plain SMTP (used only when GRAPH_* is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional extra recipients on top of the in-app list (comma separated)
ALERT_TO_EMAIL=
# Fallback time zone for recipients whose Outlook time zone is unknown (IANA name)
ALERT_TIMEZONE=UTC

# --- Checker worker ---
CHECK_INTERVAL_MS=120000
# Mark a server offline when its agent is silent this long
SERVER_OFFLINE_AFTER_MS=300000
# Days of check/metric history to keep
RETENTION_DAYS=30

# --- Public URLs (the API is served under /api on the same domain) ---
PUBLIC_API_URL=https://devmonitor.veganext.com/api
PUBLIC_WEB_URL=https://devmonitor.veganext.com
