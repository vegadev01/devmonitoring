# DOMAIN=devmonitor.veganext.com -> automatic HTTPS (DNS must point here).
# DOMAIN=:8080 (+ HTTP_PORT=8080) -> plain HTTP on any address/IP, no certificate.
{$DOMAIN:devmonitor.veganext.com} {
	encode zstd gzip
	reverse_proxy web:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
